        "message": "={{ (() => {\n  const esc = s => String(s ?? \"\")\n    .replaceAll(\"&\", \"＆\")\n    .replaceAll(\"<\", \"‹\")\n    .replaceAll(\">\", \"›\");\n\n  return [\n    \"Ticket-ID: \" + $json.ticket_id,\n    \"Betreff: \" + esc($('Ticket anlegen').item.json.betreff),\n    \"Text: \" + esc($('Ticket anlegen').item.json.text),\n    \"Kategorie: \" + $json.kategorie,\n    \"Priorität: \" + $json.prioritaet,\n    \"Begründung: \" + esc($('Antwort prüfen').item.json.begruendung),\n    \"Entwurf: \" + esc($json.entwurf_text),\n    \"Frist: bis \" + $now.plus({ hours: 24 }).toFormat(\"dd.MM.yyyy HH:mm\") + \" Uhr\"\n  ].join(\"<br>\");\n})() }}",
